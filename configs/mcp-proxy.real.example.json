{
  "upstreams": [
    {
      "server_id": "local_api",
      "transport": "stdio",
      "command": "/absolute/path/to/mcp-server",
      "args": [],
      "env_from_env": {
        "UPSTREAM_API_KEY": "INTENTSHIELD_LOCAL_API_KEY"
      }
    },
    {
      "server_id": "remote_api",
      "transport": "streamable_http",
      "url": "https://mcp.example.com/mcp",
      "headers_from_env": {
        "Authorization": "INTENTSHIELD_REMOTE_AUTHORIZATION"
      }
    }
  ],
  "database_path": "intentshield-real.db",
  "allowed_tools": [
    "local_api:read_record",
    "remote_api:get_status"
  ],
  "prohibited_tools": [],
  "read_only_tools": [
    "local_api:read_record",
    "remote_api:get_status"
  ],
  "resource_fields": {},
  "destination_fields": {},
  "allowed_resources_by_tool": {},
  "allowed_destinations_by_tool": {},
  "grounding_terms_by_tool": {
    "local_api:read_record": ["record", "profile", "account"],
    "remote_api:get_status": ["status", "state", "health"]
  },
  "expose_upstream_descriptions": false,
  "call_budget": 8,
  "injection_block_threshold": 0.75,
  "minimum_intent_alignment": 0.6,
  "approval_ttl_seconds": 600,
  "max_upstreams": 8,
  "max_total_tools": 2000,
  "max_total_schema_bytes": 16000000,
  "max_result_bytes": 4000000,
  "max_result_content_blocks": 1000
}
