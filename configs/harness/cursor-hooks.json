{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "intentshield-hook cursor --deadline 30"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "intentshield-hook cursor --deadline 30",
        "failClosed": true
      }
    ],
    "afterMCPExecution": [
      {
        "command": "intentshield-hook cursor --deadline 30"
      }
    ]
  }
}
