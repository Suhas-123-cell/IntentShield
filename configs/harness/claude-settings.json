{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "intentshield-hook claude"}]}],
    "PreToolUse": [{"matcher": "mcp__.*|ReadMcpResource(Dir)?(Tool)?|ListMcpResources(Tool)?",
                    "hooks": [{"type": "command", "command": "intentshield-hook claude", "onFailure": "block"}]}],
    "PostToolUse": [{"matcher": "mcp__.*|ReadMcpResource(Dir)?(Tool)?|ListMcpResources(Tool)?",
                     "hooks": [{"type": "command", "command": "intentshield-hook claude"}]}],
    "PostToolUseFailure": [{"matcher": "mcp__.*|ReadMcpResource(Dir)?(Tool)?|ListMcpResources(Tool)?",
                            "hooks": [{"type": "command", "command": "intentshield-hook claude"}]}]
  }
}
