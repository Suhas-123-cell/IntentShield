(version 1)
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote unix-socket))
(deny file-write* (subpath "/Users"))
(deny file-read* (regex #"^/Users/[^/]+/\.ssh(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.aws(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.gnupg(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.config(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.claude(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.codex(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.gemini(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/\.cursor(/|$)"))
(deny file-read* (regex #"^/Users/[^/]+/Library/Keychains(/|$)"))
(deny file-read* (regex #"/\.env($|\.)"))
