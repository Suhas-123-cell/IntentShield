# Copy this file to .env and fill in only the credentials you use.
# IntentShield loads this file at startup without overriding variables already
# exported by the parent process.

# Gemini is the only model provider. The key is required for live model runs.
GEMINI_API_KEY=

# Optional model override. The default is listed below.
INTENTSHIELD_GEMINI_MODEL=gemini-3.5-flash
INTENTSHIELD_MODEL_MAX_CONCURRENCY=2

# Local DeBERTa-v3-small artifact created by the training command in README.md.
INTENTSHIELD_INTENT_MODEL_DIR=artifacts/intent-deberta-v3-small

# Optional: make the web dashboard use the real guarded MCP catalog/executors.
# Leave blank to use the fully local simulated inbox/outbox tools.
INTENTSHIELD_PROXY_CONFIG=

# Used by configs/mcp-proxy.real.example.json for a stdio upstream server.
INTENTSHIELD_LOCAL_API_KEY=

# Used by configs/mcp-proxy.real.example.json for an HTTP upstream server.
# Include the auth scheme if the server expects one, for example: Bearer <token>
INTENTSHIELD_REMOTE_AUTHORIZATION=

# Optional: enables the local human approval endpoint for Streamable HTTP.
# Generate a value with: openssl rand -hex 32
INTENTSHIELD_CONTROL_TOKEN=
